rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    // The collections the sync layer writes under users/{uid}/ (the keys of createRepositories()).
    // A new synced collection must be added here, otherwise its pushes are denied.
    function isSyncedCollection(col) {
      return col in ['schedules', 'occurrences', 'academicPeriods', 'subjects', 'workouts', 'exerciseHistory', 'destinations'];
    }

    // Every synced record carries its own id, an ISO `updatedAt`, an integer `version` and a soft-delete flag,
    // and its document id must equal record.id (so a retry can only ever overwrite itself, never duplicate).
    function isValidRecord(id) {
      let d = request.resource.data;
      return d.id == id && d.updatedAt is string && d.version is int && d.deleted is bool;
    }

    // Each user can only touch their own profile and their own synced collections beneath it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid) && request.resource.data.email == resource.data.email;

      match /{col}/{id} {
        allow read, delete: if isOwner(uid) && isSyncedCollection(col);
        allow create, update: if isOwner(uid) && isSyncedCollection(col) && isValidRecord(id);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
